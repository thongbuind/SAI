{
  "compare-kernel": {
    "candidate": { "label": "Kernel ứng viên", "source": "registry:arch/attention_kernel", "initial": "eager", "help": "Mốc là attention_kernel trong config của từng model." },
    "models": {
      "label": "Mô hình",
      "source": "models:SAI_modular",
      "widget": "chips",
      "initial": ["SAI_modular_35M", "SAI_modular_100M", "SAI_modular_375M"],
      "help": "Đo trên shape attention (H, Hkv, D) của từng model đã chọn."
    },
    "batch_size": { "label": "Batch (B)", "min": 1, "width": "half" },
    "seq_len": { "label": "Độ dài chuỗi (T)", "min": 1, "width": "half" },
    "dtype": { "label": "Kiểu số", "widget": "segmented" },
    "device": { "label": "Thiết bị", "widget": "segmented" },
    "causal": { "label": "Causal mask" },
    "repeats": { "label": "Số lần lặp", "min": 1, "help": "Thời gian là trung vị của các lần lặp.", "group": "advanced" }
  },
  "compare-objective": {
    "candidate": { "label": "Objective ứng viên", "source": "registry:objectives/objective", "initial": "lm_ce", "help": "Đăng ký thêm vào OBJECTIVES để có lựa chọn khác." },
    "experiments": {
      "label": "Experiment",
      "source": "experiments",
      "widget": "chips",
      "initial": ["SAI_35M", "SAI_100M", "SAI_375M"],
      "help": "Đo trên cỡ head (d_model, vocab) của model trong từng experiment."
    },
    "candidate_chunk_size": { "label": "Chunk ứng viên", "min": 1, "help": "Trống: như loss_chunk_size của mốc." },
    "stage": {
      "label": "Stage làm mốc",
      "source": "experiments",
      "filter_by": "experiments",
      "initial": "pretrain",
      "help": "Lấy objective, loss_chunk_size và max_microbatch_tokens từ params của stage."
    },
    "tokens": { "label": "Số token (N)", "min": 1, "help": "Trống: max_microbatch_tokens của stage." },
    "dtype": { "label": "Kiểu số", "widget": "segmented" },
    "device": { "label": "Thiết bị", "widget": "segmented" },
    "repeats": { "label": "Số lần lặp", "min": 1, "help": "Thời gian là trung vị của các lần lặp.", "group": "advanced" }
  },
  "infer": {
    "model": { "label": "Mô hình", "source": "checkpoints", "initial": "SAI_375M", "width": "half" },
    "checkpoint": { "label": "Checkpoint", "source": "checkpoints", "filter_by": "model", "display": "basename", "initial": "model/sft1_375M.pt", "width": "half" },
    "device": { "label": "Thiết bị", "widget": "segmented" },
    "prompts": {
      "label": "Câu hỏi",
      "widget": "lines",
      "help": "Mỗi dòng một câu hỏi. Mặc định là benchmark của lab; sửa xong bấm \"Lưu vào benchmark\" để giữ cho lần sau."
    },
    "variants": {
      "label": "Biến thể",
      "min_items": 1,
      "max_items": 4,
      "baseline": true,
      "initial": [
        { "name": "default" },
        { "name": "sample", "generation": { "strategy": "sample", "temperature": 0.8, "top_p": 0.95, "seed": 0 } }
      ]
    },
    "variants[].name": { "label": "Tên", "summary": "{}" },
    "variants[].decoder": { "label": "Decoder", "source": "registry:inference/decoder", "group": "advanced" },
    "variants[].generation": { "label": "Cấu hình sinh", "inline": true },
    "variants[].generation.strategy": { "label": "Chiến lược", "choices": ["auto", "beam", "greedy", "sample"], "widget": "segmented", "summary": "{}", "help": "auto: beam search." },
    "variants[].generation.beam_size": { "label": "Beam size", "widget": "slider", "min": 1, "max": 10, "step": 1, "summary": "×{}", "visible_when": { "strategy": ["auto", "beam"] } },
    "variants[].generation.length_penalty": { "label": "Length penalty", "widget": "slider", "min": 0, "max": 3, "step": 0.1, "visible_when": { "strategy": ["auto", "beam"] } },
    "variants[].generation.temperature": { "label": "Nhiệt độ", "widget": "slider", "min": 0.05, "max": 2, "step": 0.05, "summary": "t={}", "visible_when": { "strategy": ["sample"] } },
    "variants[].generation.top_p": { "label": "Top-p", "widget": "slider", "min": 0.05, "max": 1, "step": 0.05, "summary": "p={}", "visible_when": { "strategy": ["sample"] } },
    "variants[].generation.max_new_tokens": { "label": "Số token tối đa", "min": 1, "max": 1024, "summary": "{} tok", "group": "advanced" },
    "variants[].generation.stable_steps": { "label": "Dừng khi ổn định sau (bước)", "min": 1, "help": "Để trống: chạy tới hết beam.", "group": "advanced", "visible_when": { "strategy": ["auto", "beam"] } },
    "variants[].generation.top_k": { "label": "Top-k", "min": 0, "help": "0: không giới hạn.", "group": "advanced", "visible_when": { "strategy": ["sample"] } },
    "variants[].generation.seed": { "label": "Seed", "help": "Để trống: mỗi lần chạy ra kết quả khác.", "group": "advanced", "visible_when": { "strategy": ["sample"] } },
    "variants[].generation.repetition_penalty": { "label": "Repetition penalty", "min": 0.01, "group": "advanced" },
    "variants[].generation.no_repeat_ngram_size": { "label": "Cấm lặp n-gram cỡ", "min": 0, "help": "0: tắt.", "group": "advanced" },
    "variants[].generation.lowercase": { "label": "Viết thường prompt", "group": "advanced" },
    "variants[].generation.stop_sequences": { "hidden": true }
  }
}
