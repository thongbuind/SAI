---
// Một trang tài liệu Lab, sinh từ src/content/lab/<slug>.md.
import { render } from "astro:content";
import DocLayout from "../../layouts/DocLayout.astro";
import { labDocs, type LabDoc } from "../../lib/docs";

export async function getStaticPaths() {
  const docs = await labDocs();
  return docs.map(doc => ({ params: { slug: doc.id }, props: { doc, docs } }));
}

interface Props {
  doc: LabDoc;
  docs: LabDoc[];
}
const { doc, docs } = Astro.props;
const { Content, headings } = await render(doc);
---
<DocLayout doc={doc} docs={docs} headings={headings}>
  <Content />
</DocLayout>
