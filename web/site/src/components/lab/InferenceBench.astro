---
// Bàn thử nghiệm phòng Suy luận: vùng kết quả (giữa) và control center (phải) trong khung WorkbenchPage.
// Slot mặc định là phần đầu trang (breadcrumb, tiêu đề) do WorkbenchPage truyền vào, đặt trên vùng kết quả.
// Form dựng từ describe; ô câu hỏi mở sẵn benchmark của lab. Nút Chạy gọi "python -m foundation_lab infer" qua
// web/backend (python -m web --lab); kết quả đọc từ runs/infer/<run_id>/. Phần tử tạo lúc chạy dùng style trong
// styles/lab.css.
import Button from "../Button.astro";
import Icon from "../Icon.astro";

interface Props {
  command: string;
}
const { command } = Astro.props;
---
<section class="wb-stage" id="bench" data-command={command} aria-label="Kết quả">
  <slot />
  <div class="stage-head">
    <div class="run-picker">
      <button class="run-picker-button" type="button" id="bench-picker" aria-haspopup="listbox" aria-expanded="false" aria-controls="bench-history">
        <Icon name="clock" /><span id="bench-picker-label">Chưa có lần chạy</span><Icon name="chevron-down" class="chev" />
      </button>
      <ul class="run-menu" id="bench-history" role="listbox" aria-label="Các lần chạy" hidden></ul>
    </div>
    <span class="lab-state" id="bench-state" hidden></span>
    <span class="stage-grow"></span>
    <span class="t-caption" id="bench-timing"></span>
    <button class="wb-open-control" type="button" id="wb-open-control" aria-controls="wb-control" aria-expanded="false"><Icon name="sliders" />Cấu hình</button>
  </div>
  <progress id="bench-progress" max="1" value="0" hidden></progress>

  <div class="stage-body" aria-live="polite">
    <div class="stage-empty" id="bench-empty">
      <p class="t-h4">Chưa có lần chạy</p>
      <p class="t-small">Chọn checkpoint, câu hỏi và vài biến thể ở control center rồi bấm Chạy. Lệnh <code>python -m foundation_lab {command}</code> chạy trên máy này; kết quả nằm trong <code>runs/{command}/</code>.</p>
    </div>
    <p class="bench-error" id="bench-run-error" role="alert" hidden></p>
    <section class="stage-block" id="bench-metrics-block" aria-label="Metric" hidden><div id="bench-metrics"></div></section>
    <section class="stage-block" id="bench-compare-block" aria-label="Câu trả lời" hidden><div id="bench-compare"></div></section>
  </div>
</section>

<aside class="wb-control" id="wb-control" aria-labelledby="bench-control-title">
  <header class="control-head">
    <h2 class="t-h4" id="bench-control-title">Control center</h2>
    <span class="t-caption">{command}</span>
  </header>
  <div class="control-body" id="bench-fields"><p class="t-caption">Đang đọc mô tả lab…</p></div>
  <footer class="control-foot">
    <p class="bench-error" id="bench-form-error" role="alert" hidden></p>
    <div class="control-actions">
      <span class="t-caption" id="bench-run-count"></span>
      <Button id="bench-cancel" size="sm" icon="close">Huỷ</Button>
      <Button id="bench-run" variant="primary" size="sm" icon="play">Chạy</Button>
    </div>
  </footer>
</aside>

<dialog class="bench-confirm" id="bench-confirm" aria-labelledby="bench-confirm-title">
  <h2 class="t-h4" id="bench-confirm-title">Chạy lệnh trên máy này?</h2>
  <p class="t-small" id="bench-confirm-text"></p>
  <div class="control-actions">
    <Button id="bench-confirm-cancel" size="sm">Thôi</Button>
    <Button id="bench-confirm-run" variant="primary" size="sm" icon="play">Chạy</Button>
  </div>
</dialog>

<script>
  import {
    ACTIVE_STATES, DESCRIBE_FORMAT_VERSION, cancelJob, fetchBenchmark, fetchDescription, getRun, listRuns, saveBenchmark,
    submitJob, watchRun,
    type LabEvent, type RunDetail, type RunState, type RunSummary,
  } from "../../lib/lab/labApi";
  import { FormError, objectControl, type Control, type FieldHints } from "../../lib/lab/specForm";
  import { compareGrid, formatSeconds, metricsTable, type InferRecord } from "../../lib/lab/resultView";
  import { RequestError } from "../../lib/http";
  import fieldHints from "../../data/lab_fields.json";

  // Số dòng stderr cuối hiện khi lệnh lab lỗi mà không ghi được sự kiện "failed" (vd. lỗi config).
  const STDERR_SHOWN_LINES = 6;
  const STATE_LABELS: Record<RunState, string> = {
    queued: "Đang chờ", running: "Đang chạy", succeeded: "Xong", failed: "Lỗi", cancelled: "Đã huỷ", incomplete: "Dừng giữa chừng",
  };
  // run_id của lab: "20261024-021117-8eb5" (ngày-giờ-hậu tố).
  const RUN_ID_PATTERN = /^(\d{4})(\d{2})(\d{2})-(\d{2})(\d{2})/;
  // Khoá câu hỏi trong spec của lệnh infer; ô của khoá này mở sẵn benchmark.
  const PROMPTS_KEY = "prompts";

  const root = document.getElementById("bench")!;
  const command = root.dataset.command!;
  const hints = (fieldHints as Record<string, FieldHints>)[command];
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const fields = $("bench-fields");
  const formError = $("bench-form-error");
  const runButton = $<HTMLButtonElement>("bench-run");
  const cancelButton = $<HTMLButtonElement>("bench-cancel");
  const runCount = $("bench-run-count");
  const picker = $<HTMLButtonElement>("bench-picker");
  const pickerLabel = $("bench-picker-label");
  const history = $("bench-history");
  const stateBadge = $("bench-state");
  const timing = $("bench-timing");
  const progress = $<HTMLProgressElement>("bench-progress");
  const runError = $("bench-run-error");
  const empty = $("bench-empty");
  const metricsBlock = $("bench-metrics-block");
  const metricsSlot = $("bench-metrics");
  const compareBlock = $("bench-compare-block");
  const compareSlot = $("bench-compare");
  const confirmDialog = $<HTMLDialogElement>("bench-confirm");
  const confirmText = $("bench-confirm-text");

  let form: Control | null = null;
  let runs: RunSummary[] = [];
  let currentRunId: string | null = null;
  let stopWatching: (() => void) | null = null;
  let fillAnswer: ((record: InferRecord) => void) | null = null;

  runButton.disabled = true;
  cancelButton.hidden = true;

  function showError(element: HTMLElement, message: string | null) {
    element.textContent = message ?? "";
    element.hidden = message === null;
  }

  const isActive = (state: RunState) => ACTIVE_STATES.includes(state);
  const asList = (value: unknown) => (Array.isArray(value) ? value : []);
  const basename = (path: unknown) => String(path ?? "").split("/").at(-1)!.replace(/\.[^.]+$/, "");

  function runTitle(runId: string): string {
    const match = RUN_ID_PATTERN.exec(runId);
    return match ? `${match[3]}/${match[2]} ${match[4]}:${match[5]}` : runId;
  }

  function runSummaryText(config: Record<string, unknown> | null): string {
    if (!config) return "";
    return `${basename(config.checkpoint)} · ${asList(config.prompts).length} câu × ${asList(config.variants).length} biến thể`;
  }

  // ----- Control center -----

  function updateRunCount() {
    try {
      const spec = form!.read() as Record<string, unknown>;
      runCount.textContent = `${asList(spec.prompts).length * asList(spec.variants).length} lượt sinh`;
    } catch (error) {
      if (!(error instanceof FormError)) throw error;
      runCount.textContent = "Chưa hợp lệ";
    }
  }

  function confirmRun(spec: Record<string, unknown>): Promise<boolean> {
    const prompts = asList(spec.prompts).length;
    const variants = asList(spec.variants).length;
    confirmText.textContent = `Lệnh sẽ nạp ${spec.model} với trọng số ${spec.checkpoint}, rồi sinh ${prompts * variants} câu trả lời (${prompts} câu hỏi × ${variants} biến thể). Mỗi lúc chỉ một lệnh chạy; lệnh khác sẽ xếp hàng.`;
    confirmDialog.showModal();
    return new Promise(resolve => {
      confirmDialog.addEventListener("close", () => resolve(confirmDialog.returnValue === "run"), { once: true });
    });
  }

  $("bench-confirm-run").addEventListener("click", () => confirmDialog.close("run"));
  $("bench-confirm-cancel").addEventListener("click", () => confirmDialog.close("cancel"));

  runButton.addEventListener("click", async () => {
    showError(formError, null);
    let spec: Record<string, unknown>;
    try {
      spec = form!.read() as Record<string, unknown>;
    } catch (error) {
      if (!(error instanceof FormError)) throw error;
      showError(formError, error.message);
      return;
    }
    if (!(await confirmRun(spec))) return;
    try {
      const runId = await submitJob(command, spec);
      window.dispatchEvent(new CustomEvent("workbench:job-submitted"));
      await refreshHistory();
      await openRun(runId);
    } catch (error) {
      if (!(error instanceof RequestError)) throw error;
      showError(formError, error.message);
    }
  });

  cancelButton.addEventListener("click", async () => {
    if (!currentRunId) return;
    cancelButton.disabled = true;
    try {
      await cancelJob(command, currentRunId);
    } catch (error) {
      if (!(error instanceof RequestError)) throw error;
      showError(runError, error.message);
    } finally {
      cancelButton.disabled = false;
    }
  });

  // ----- Benchmark -----

  // Thanh dưới ô câu hỏi: cho biết ô đang khớp benchmark của lab hay đã sửa; đã sửa thì có nút ghi đè benchmark.
  function benchmarkBar(prompts: Control, saved: string[]): HTMLElement {
    let benchmark = saved;
    const bar = document.createElement("div");
    bar.className = "bench-benchmark";
    const status = document.createElement("span");
    status.className = "t-caption";
    const save = document.createElement("button");
    save.type = "button";
    save.className = "lab-link";
    save.textContent = "Lưu vào benchmark";
    bar.append(status, save);

    function render() {
      const isSaved = JSON.stringify(prompts.read()) === JSON.stringify(benchmark);
      status.textContent = isSaved ? `Benchmark của lab · ${benchmark.length} câu` : "Đã sửa, chưa lưu vào benchmark";
      bar.dataset.saved = String(isSaved);
      save.hidden = isSaved;
    }
    save.addEventListener("click", async () => {
      showError(formError, null);
      save.disabled = true;
      try {
        benchmark = await saveBenchmark(prompts.read() as string[]);
      } catch (error) {
        if (!(error instanceof RequestError)) throw error;
        showError(formError, error.message);
      } finally {
        save.disabled = false;
      }
      render();
    });
    prompts.element.addEventListener("input", render);
    render();
    return bar;
  }

  // ----- Chọn lần chạy -----

  function setPicker(open: boolean) {
    history.hidden = !open;
    picker.setAttribute("aria-expanded", String(open));
    if (open) history.querySelector<HTMLElement>("[aria-selected='true'], [role='option']")?.focus();
  }

  function historyItem(run: RunSummary): HTMLLIElement {
    const item = document.createElement("li");
    item.setAttribute("role", "option");
    item.tabIndex = -1;
    item.setAttribute("aria-selected", String(run.run_id === currentRunId));
    const title = document.createElement("span");
    title.className = "run-menu-title";
    title.textContent = runTitle(run.run_id);
    const summary = document.createElement("span");
    summary.className = "t-caption";
    summary.textContent = runSummaryText(run.config);
    const state = document.createElement("span");
    state.className = "lab-state";
    state.dataset.state = run.state;
    state.textContent = STATE_LABELS[run.state];
    item.append(title, summary, state);
    const choose = () => {
      setPicker(false);
      picker.focus();
      void openRun(run.run_id);
    };
    item.addEventListener("click", choose);
    item.addEventListener("keydown", event => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        choose();
      } else if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault();
        const sibling = event.key === "ArrowDown" ? item.nextElementSibling : item.previousElementSibling;
        (sibling as HTMLElement | null)?.focus();
      }
    });
    return item;
  }

  async function refreshHistory() {
    runs = await listRuns(command);
    if (runs.length === 0) {
      const none = document.createElement("li");
      none.className = "t-caption run-menu-empty";
      none.textContent = `Chưa có lần chạy nào trong runs/${command}/.`;
      history.replaceChildren(none);
    } else {
      history.replaceChildren(...runs.map(historyItem));
    }
  }

  picker.addEventListener("click", () => setPicker(history.hidden));
  history.addEventListener("keydown", event => {
    if (event.key === "Escape") {
      setPicker(false);
      picker.focus();
    }
  });
  document.addEventListener("click", event => {
    if (!history.hidden && !(event.target as Element).closest(".run-picker")) setPicker(false);
  });

  // ----- Vùng kết quả -----

  function setState(state: RunState) {
    stateBadge.hidden = false;
    stateBadge.textContent = STATE_LABELS[state];
    stateBadge.dataset.state = state;
    cancelButton.hidden = !isActive(state);
    progress.hidden = !isActive(state);
  }

  function failureText(detail: RunDetail): string | null {
    if (detail.state !== "failed") return null;
    const failed = detail.events.findLast(event => event.kind === "failed");
    if (failed) return String(failed.error);
    return detail.stderr.slice(-STDERR_SHOWN_LINES).join("\n") || "Lệnh lab thất bại.";
  }

  // Run đang chạy: dựng lưới theo câu hỏi × biến thể rồi điền dần từ SSE (luồng phát lại mọi sự kiện từ đầu).
  // Run đã xong: điền từ result.json.
  function renderRun(detail: RunDetail) {
    setState(detail.state);
    pickerLabel.textContent = `${runTitle(detail.run_id)} · ${basename(detail.config?.checkpoint)}`;
    for (const item of history.querySelectorAll("[role='option']")) item.setAttribute("aria-selected", "false");
    const index = runs.findIndex(run => run.run_id === detail.run_id);
    history.children[index]?.setAttribute("aria-selected", "true");
    timing.textContent = detail.result
      ? `${formatSeconds(detail.result.timings.total_ms)} · nạp ${formatSeconds(detail.result.timings.load_ms)}`
      : runSummaryText(detail.config);
    showError(runError, failureText(detail));
    empty.hidden = true;

    metricsSlot.replaceChildren();
    metricsBlock.hidden = !detail.result;
    if (detail.result) metricsSlot.append(metricsTable(detail.result.metrics));

    const prompts = asList(detail.config?.prompts).map(String);
    const variants = asList(detail.config?.variants).map(variant => String((variant as Record<string, unknown>).name));
    const grid = compareGrid(prompts, variants);
    fillAnswer = grid.fill;
    compareSlot.replaceChildren(grid.element);
    compareBlock.hidden = prompts.length === 0;
    for (const record of detail.result?.records ?? []) grid.fill(record as unknown as InferRecord);
  }

  function onEvent(runId: string, event: LabEvent) {
    if (runId !== currentRunId) return;
    if (event.kind === "started" || event.kind === "progress") {
      progress.max = Number(event.total);
      progress.value = Number(event.done ?? 0);
      timing.textContent = `${progress.value}/${progress.max} lượt`;
    } else if (event.kind === "record") {
      fillAnswer?.(event.record as InferRecord);
    } else if (event.kind === "failed") {
      showError(runError, String(event.error));
    }
  }

  async function openRun(runId: string) {
    stopWatching?.();
    stopWatching = null;
    currentRunId = runId;
    try {
      const detail = await getRun(command, runId);
      if (runId !== currentRunId) return;
      renderRun(detail);
      if (isActive(detail.state)) {
        stopWatching = watchRun(command, runId, event => onEvent(runId, event), () => {
          if (runId !== currentRunId) return;
          void refreshHistory().then(() => openRun(runId));
        });
      }
    } catch (error) {
      if (!(error instanceof RequestError)) throw error;
      showError(runError, error.message);
    }
  }

  async function init() {
    try {
      const [description, benchmark] = await Promise.all([fetchDescription(), fetchBenchmark()]);
      if (description.format_version !== DESCRIBE_FORMAT_VERSION) {
        throw new RequestError(`Lab mô tả theo định dạng ${description.format_version}, trang này hiểu ${DESCRIBE_FORMAT_VERSION}. Build lại web.`);
      }
      const spec = description.commands[command]?.spec;
      if (!spec) throw new RequestError(`Lab không có lệnh "${command}".`);
      form = objectControl("", spec, hints, description, { [PROMPTS_KEY]: benchmark });
      fields.replaceChildren(form.element);
      fields.querySelector(`[data-path="${PROMPTS_KEY}"]`)!.append(benchmarkBar(form.children![PROMPTS_KEY], benchmark));
      fields.addEventListener("input", updateRunCount);
      fields.addEventListener("change", updateRunCount);
      updateRunCount();
      runButton.disabled = false;
      await refreshHistory();
      if (runs.length > 0) await openRun(runs[0].run_id);
    } catch (error) {
      if (!(error instanceof RequestError)) throw error;
      fields.replaceChildren();
      showError(formError, error.message);
    }
  }

  void init();
</script>
