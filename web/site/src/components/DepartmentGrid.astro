---
// DepartmentCard trên Figma, ghép thành lưới các phòng ban (lab.json). Bấm thẻ để xem registry ở khung chi tiết bên dưới.
import IconChip from "./IconChip.astro";
import lab from "../data/lab.json";
import { departmentIcon } from "../lib/departments";
import { capitalize, docstringToHtml } from "../lib/text";

const OPEN_BY_DEFAULT = "arch";
---
<div class="departments">
  <div class="grid">
    {lab.departments.map(department => (
      <button class="card glass-panel" type="button" id={department.code} data-department={department.code} aria-controls="department-detail" aria-pressed={String(department.code === OPEN_BY_DEFAULT)}>
        <span class="head"><IconChip icon={departmentIcon(department.code)} /><span class="code">{department.code}</span></span>
        <span class="t-h4">{department.name}</span>
        <span class="t-small" set:html={capitalize(docstringToHtml(department.description))} />
        <span class="registries">{department.registries.length ? department.registries.map(r => r.kind).join(" · ") : "không có registry riêng"}</span>
      </button>
    ))}
  </div>
  <div class="detail glass-panel" id="department-detail" aria-live="polite">
    {lab.departments.map(department => (
      <div class="detail-body" data-detail={department.code} hidden={department.code !== OPEN_BY_DEFAULT}>
        <div class="detail-text">
          <span class="t-overline">{department.name} · {department.code}</span>
          {department.registries.length ? (
            <p class="t-small">Thêm implementation mới bằng <code>@REGISTRY.register("ten")</code> trong phòng này rồi chọn tên đó trong config.</p>
          ) : (
            <p class="t-small">Phòng này cung cấp hạ tầng cho các phòng khác, không có registry để đăng ký biến thể.</p>
          )}
        </div>
        {department.registries.length > 0 && (
          <dl class="registry-list">
            {department.registries.map(registry => (
              <div><dt>{registry.kind}</dt><dd>{registry.names.map(name => <span class="name">{name}</span>)}</dd></div>
            ))}
          </dl>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .departments { display: flex; flex-direction: column; gap: var(--space-4); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .card { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-6); text-align: left; font: inherit; color: inherit; cursor: pointer; border-radius: var(--radius-card); border: 1px solid var(--border-default); background: var(--surface-base); box-shadow: var(--elevation-1); transition: border-color var(--duration-base), box-shadow var(--duration-base); }
  .card:hover { border-color: var(--border-strong); box-shadow: var(--elevation-2); }
  .card[aria-pressed="true"] { border-color: var(--border-focus); background: var(--fill-accent-muted); box-shadow: var(--elevation-2); }
  .head { display: flex; align-items: center; gap: var(--space-3); }
  .code { padding: 1px 8px; border-radius: var(--radius-inline); background: var(--fill-accent-muted); color: var(--text-accent); font: 400 12px/1.6 var(--font-mono); }
  .registries { font: 400 12px/1.6 var(--font-mono); color: var(--text-tertiary); }
  .detail { padding: var(--space-6); border-radius: var(--radius-card); border: 1px solid var(--border-focus); background: var(--surface-base); }
  .detail-body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-6); }
  .detail-text { display: flex; flex-direction: column; gap: var(--space-3); }
  .detail-text p { margin: 0; }
  .registry-list { margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .registry-list div { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: var(--space-3); align-items: baseline; }
  dt { font: 400 12px/1.6 var(--font-mono); color: var(--text-tertiary); }
  dd { margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .name { padding: var(--space-1) var(--space-3); border-radius: var(--radius-control); border: 1px solid var(--border-strong); background: var(--fill-accent-muted); color: var(--text-accent); font-size: 12px; line-height: 1.5; }
  @media (max-width: 900px) { .grid, .detail-body { grid-template-columns: 1fr; } .registry-list div { grid-template-columns: 1fr; gap: 4px; } }
</style>

<script>
  const cards = document.querySelectorAll<HTMLButtonElement>("[data-department]");
  const details = document.querySelectorAll<HTMLElement>("[data-detail]");
  cards.forEach(card => {
    card.addEventListener("click", () => {
      const code = card.dataset.department;
      cards.forEach(other => other.setAttribute("aria-pressed", String(other === card)));
      details.forEach(detail => { detail.hidden = detail.dataset.detail !== code; });
    });
  });
</script>
