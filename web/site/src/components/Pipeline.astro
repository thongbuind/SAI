---
// PipelineDiagram trên Figma: các stage của experiment gốc (pipeline.json). Stage tắt hiện viền đứt.
import Icon from "./Icon.astro";
import pipeline from "../data/pipeline.json";

interface Props {
  // Cột hẹp (dưới ~640px) xếp dọc; mobile luôn xếp dọc.
  vertical?: boolean;
}
const { vertical = false } = Astro.props;
---
<div class:list={["pipeline glass-panel", { "is-vertical": vertical }]} aria-label={`Pipeline trong ${pipeline.source}`}>
  {pipeline.stages.map((stage, index) => (
    <>
      {index > 0 && <span class="arrow" aria-hidden="true"><Icon name="arrow-right" /></span>}
      <div class:list={["stage", { "is-first": index === 0, "is-off": !stage.enabled }]}>
        <b>{stage.name}</b>
        <small>{stage.enabled ? `${stage.recipe} · ${stage.data}` : "tắt mặc định"}</small>
        {stage.init && <small>init: {stage.init}</small>}
      </div>
    </>
  ))}
</div>

<style>
  .pipeline { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-6); border-radius: var(--radius-xl); border: 1px solid var(--border-default); background: var(--surface-base); }
  .stage { flex: 1 1 0; min-width: 110px; display: flex; flex-direction: column; gap: 2px; padding: var(--space-3) var(--space-4); text-align: center; border-radius: var(--radius-md); border: 1px solid var(--border-default); background: var(--surface-base); }
  .stage b { font: 500 13px/1.4 var(--font-sans); }
  .stage small { font: 400 12px/1.5 var(--font-mono); color: var(--text-tertiary); overflow-wrap: anywhere; }
  .is-first { background: var(--fill-accent-muted); border-color: var(--border-strong); }
  .is-off { background: none; border-style: dashed; border-color: var(--border-strong); }
  .is-off b { color: var(--text-tertiary); }
  .arrow { display: flex; align-items: center; flex: none; color: var(--text-tertiary); }
  .arrow::before { content: ""; width: 24px; height: 2px; background: var(--border-strong); }
  .is-vertical { flex-direction: column; align-items: stretch; }
  .is-vertical .stage { flex: none; }
  .is-vertical .arrow { align-self: center; transform: rotate(90deg); }
  @media (max-width: 900px) {
    .pipeline { flex-direction: column; align-items: stretch; }
    .stage { flex: none; }
    .arrow { align-self: center; transform: rotate(90deg); }
  }
</style>
