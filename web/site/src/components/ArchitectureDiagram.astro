---
// ArchitectureDiagram trên Figma: sơ đồ decoder-only của SAI (chung cho mọi cỡ, kích thước lấy từ models.json).
import Icon from "./Icon.astro";
import models from "../data/models.json";

const vocab = models[0].vocab_size.toLocaleString("vi-VN");
const nodes = {
  input: { label: "Token IDs", detail: `(B, T) · SentencePiece Unigram ${vocab}` },
  embedding: { label: "Embedding", detail: `${vocab} × d_model · weight tying` },
  block: [
    { label: "RMSNorm" },
    { label: "Grouped Query Attention", detail: "RoPE · causal mask · SDPA", accent: true },
    { label: "+ residual", muted: true },
    { label: "RMSNorm" },
    { label: "SwiGLU FFN", detail: "up × SiLU(gate) · không bias", accent: true },
    { label: "+ residual", muted: true },
  ],
  output: [{ label: "RMSNorm" }, { label: "LM head → logits", detail: `(B, T, ${vocab})`, accent: true }],
};
---
<div class="diagram glass-panel" role="img" aria-label="Sơ đồ SAI: token IDs qua embedding, N decoder block (RMSNorm, Grouped Query Attention, residual, RMSNorm, SwiGLU, residual), rồi RMSNorm và LM head ra logits.">
  <div class="node"><b>{nodes.input.label}</b><small>{nodes.input.detail}</small></div>
  <span class="down"><Icon name="chevron-down" /></span>
  <div class="node"><b>{nodes.embedding.label}</b><small>{nodes.embedding.detail}</small></div>
  <span class="down"><Icon name="chevron-down" /></span>
  <div class="block">
    <span class="t-overline block-label">× N decoder block · pre-norm</span>
    {nodes.block.map((node, index) => (
      <>
        {index > 0 && <span class="down"><Icon name="chevron-down" /></span>}
        <div class:list={["node", { "is-accent": node.accent, "is-muted": node.muted }]}><b>{node.label}</b>{node.detail && <small>{node.detail}</small>}</div>
      </>
    ))}
  </div>
  {nodes.output.map(node => (
    <>
      <span class="down"><Icon name="chevron-down" /></span>
      <div class:list={["node", { "is-accent": node.accent }]}><b>{node.label}</b>{node.detail && <small>{node.detail}</small>}</div>
    </>
  ))}
</div>

<style>
  .diagram { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: var(--space-8); border-radius: var(--radius-xl); border: 1px solid var(--border-default); background: var(--surface-base); }
  .node { width: min(280px, 100%); display: flex; flex-direction: column; gap: 2px; padding: var(--space-3) var(--space-4); text-align: center; border-radius: var(--radius-md); border: 1px solid var(--border-default); background: var(--surface-base); }
  .node b { font: 500 13px/1.4 var(--font-sans); color: var(--text-primary); }
  .node small { font: 400 12px/1.5 var(--font-mono); color: var(--text-tertiary); }
  .is-accent { background: var(--fill-accent-muted); border-color: var(--border-strong); }
  .is-muted { background: none; border-style: dashed; border-color: var(--border-strong); }
  .is-muted b { color: var(--text-tertiary); }
  .down { display: flex; flex-direction: column; align-items: center; color: var(--text-tertiary); }
  .down::before { content: ""; width: 2px; height: 16px; background: var(--border-strong); }
  .block { width: min(340px, 100%); display: flex; flex-direction: column; align-items: center; gap: 4px; padding: var(--space-5); border-radius: var(--radius-lg); border: 1px dashed var(--border-strong); background: var(--fill-accent-subtle); }
  .block-label { font-size: 11px; margin-bottom: var(--space-2); }
</style>
