---
// Footer gọn kiểu dev2 (logo + bản quyền một hàng), thêm phiên bản mô hình và một hàng liên kết. Dùng chung cho cả
// hai bản deploy. Năm bản quyền lấy theo thời điểm build.
import Icon from "./Icon.astro";
import { url } from "../lib/paths";
import { GITHUB_URL, HUGGING_FACE_URL, FACEBOOK_URL } from "../lib/site";
import version from "../data/version.json";

const links = [
  { label: "Foundation Lab", href: url("/lab/"), external: false },
  { label: "Trải nghiệm", href: url("/try/"), external: false },
  { label: "GitHub", href: GITHUB_URL, external: true },
  { label: "Hugging Face", href: HUGGING_FACE_URL, external: true },
  { label: "Facebook", href: FACEBOOK_URL, external: true },
];
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="t-logo footer-logo">SAI</span>
      <span class="t-eyebrow copyright">© {year} Nidai · Apache-2.0 · mô hình {version.model}</span>
    </div>
    <nav class="footer-links" aria-label="Liên kết">
      {links.map(link => (
        <a class="footer-link" href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener" : undefined}>
          {link.label}{link.external && <Icon name="external" size={12} />}
        </a>
      ))}
    </nav>
  </div>
</footer>

<style>
  .footer { position: relative; z-index: 1; border-top: 1px solid var(--border-subtle); padding-block: var(--space-8) calc(var(--space-8) + env(safe-area-inset-bottom, 0px)); }
  .footer-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4) var(--space-8); }
  .footer-brand { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-4); }
  .footer-logo { font-size: 18px; }
  .copyright { font-size: 13px; }
  .footer-links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  .footer-link { display: inline-flex; align-items: center; gap: var(--space-1); color: var(--text-tertiary); text-decoration: none; font-size: 13px; }
  .footer-link:hover { color: var(--text-primary); }
  @media (max-width: 768px) {
    .footer-inner, .footer-brand { flex-direction: column; align-items: center; text-align: center; }
    .footer-links { justify-content: center; }
  }
</style>
