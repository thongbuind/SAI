---
// ThemeToggle trên Figma. Theme áp dụng sớm bằng script inline trong BaseLayout; nút này chỉ đổi và lưu lựa chọn.
import Icon from "./Icon.astro";
---
<button class="theme-toggle" type="button" data-theme-toggle aria-label="Chuyển giao diện sáng/tối">
  <Icon name="sun" class="i-sun" />
  <Icon name="moon" class="i-moon" />
</button>

<style>
  .theme-toggle { position: relative; display: inline-grid; place-items: center; width: 32px; height: 32px; flex: none; border-radius: var(--radius-pill); border: 1px solid var(--border-strong); background: var(--fill-accent-muted); color: var(--text-accent); cursor: pointer; backdrop-filter: blur(var(--blur-control)); -webkit-backdrop-filter: blur(var(--blur-control)); transition: transform var(--duration-fast), background-color var(--duration-fast), color var(--duration-fast); }
  .theme-toggle:hover { transform: scale(1.08); background: var(--fill-accent-active); color: var(--text-primary); }
  .theme-toggle:active { transform: scale(0.95); }
  .theme-toggle :global(.icon) { position: absolute; transition: opacity var(--duration-slow), transform var(--duration-slow); }
  .theme-toggle :global(.i-moon) { opacity: 0; transform: rotate(90deg) scale(0.5); }
  /* Selector theme chỉ dùng cho state của icon (quy tắc 7 trong Foundations). */
  :global(:root[data-theme="light"]) .theme-toggle :global(.i-sun) { opacity: 0; transform: rotate(-90deg) scale(0.5); }
  :global(:root[data-theme="light"]) .theme-toggle :global(.i-moon) { opacity: 1; transform: none; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .theme-toggle :global(.i-sun) { opacity: 0; transform: rotate(-90deg) scale(0.5); }
    :global(:root:not([data-theme="dark"])) .theme-toggle :global(.i-moon) { opacity: 1; transform: none; }
  }
</style>

<script>
  const STORAGE_KEY = "sai-theme";
  const root = document.documentElement;

  function effectiveTheme(): "dark" | "light" {
    const explicit = root.dataset.theme;
    if (explicit === "dark" || explicit === "light") return explicit;
    return window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
  }

  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach(button => {
    button.addEventListener("click", () => {
      const next = effectiveTheme() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try { localStorage.setItem(STORAGE_KEY, next); } catch { /* Trình duyệt chặn lưu trữ: theme vẫn đổi trong phiên này. */ }
      window.dispatchEvent(new CustomEvent("sai-theme-change"));
    });
  });
</script>
