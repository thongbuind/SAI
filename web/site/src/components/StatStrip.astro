---
// StatStrip trên Figma: dải số liệu dưới hero. Giá trị do trang tính từ dữ liệu build (src/data).
interface Props {
  stats: { value: string; label: string }[];
}
const { stats } = Astro.props;
---
<ul class="stat-strip glass-panel" aria-label="Số liệu chính">
  {stats.map(stat => (
    <li class="stat"><span class="value">{stat.value}</span><span class="t-caption">{stat.label}</span></li>
  ))}
</ul>

<style>
  .stat-strip { list-style: none; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--space-6); padding: var(--space-6) var(--space-8); border-radius: var(--radius-lg); border: 1px solid var(--border-default); background: var(--surface-base); box-shadow: var(--elevation-1); }
  .stat { display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; }
  .value { font: 700 28px/1.2 var(--font-display); font-variant-numeric: tabular-nums; background: var(--gradient-logo); -webkit-background-clip: text; background-clip: text; color: transparent; }
  @media (max-width: 600px) { .stat-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: var(--space-6); } }
</style>
