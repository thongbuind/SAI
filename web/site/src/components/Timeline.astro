---
// TimelineItem trên Figma, ghép thành danh sách các mốc. status: done | current | planned.
interface Props {
  items: { phase: string; status: "done" | "current" | "planned"; title: string; description: string }[];
}
const { items } = Astro.props;
const STATUS_LABEL = { done: "đã xong", current: "đang làm", planned: "dự kiến" };
---
<ol class="timeline">
  {items.map(item => (
    <li data-status={item.status}>
      <span class="rail" aria-hidden="true"><span class="dot"></span></span>
      <div class="body">
        <span class="meta"><span class="t-overline">{item.phase}</span><span class="t-caption">{STATUS_LABEL[item.status]}</span></span>
        <h3 class="t-h4">{item.title}</h3>
        <p class="t-small">{item.description}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .timeline { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  li { display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: var(--space-5); }
  .rail { display: flex; flex-direction: column; align-items: center; gap: var(--space-2); padding-top: 4px; }
  .rail::after { content: ""; flex: 1; width: 2px; background: var(--border-default); }
  li:last-child .rail::after { display: none; }
  .dot { width: 14px; height: 14px; flex: none; border-radius: 50%; background: var(--fill-accent-solid); box-shadow: 0 0 0 1px var(--border-focus); }
  li[data-status="current"] .dot { box-shadow: 0 0 0 2px var(--border-focus), var(--glow); }
  li[data-status="planned"] .dot { background: var(--fill-accent-muted); box-shadow: 0 0 0 1px var(--border-strong); }
  .body { display: flex; flex-direction: column; gap: var(--space-2); padding-bottom: var(--space-10); }
  .body h3, .body p { margin: 0; }
  .meta { display: flex; align-items: center; gap: var(--space-3); }
</style>
