---
// Composer một hàng như dev2: ô nhập, nút chia sẻ, chọn mô hình (ModelMenu), nút gửi; bên dưới là badge trạng thái
// máy chủ, chỉ hiện khi mô hình chưa sẵn sàng. Danh sách mô hình và trạng thái do script trong TryServer.astro điền;
// style trong styles/chat.css.
import Icon from "../Icon.astro";
import Badge from "../Badge.astro";
import { MAX_MESSAGE_CHARS } from "../../lib/chatApi";
---
<div class="chat-dock" id="chat-dock">
  <div class="composer-wrap">
    <div class="model-menu glass-elevated anim-pop-in" id="chat-model-menu" role="listbox" aria-labelledby="chat-model-menu-title" hidden>
      <h4 class="t-overline" id="chat-model-menu-title">Chọn mô hình</h4>
    </div>
    <form class="composer glass-panel" id="chat-composer">
      <label class="sr-only" for="chat-message">Tin nhắn</label>
      <textarea id="chat-message" rows="1" maxlength={MAX_MESSAGE_CHARS} placeholder="Hỏi SAI bất cứ điều gì…"></textarea>
      <button class="icon-btn icon-btn-lg icon-btn-control" type="button" id="chat-share" aria-pressed="false" aria-label="Chia sẻ lên Cộng đồng" hidden><Icon name="share" /></button>
      <button class="model-select" type="button" id="chat-model-select" aria-haspopup="listbox" aria-expanded="false" aria-controls="chat-model-menu">
        <Icon name="cpu" class="i-cpu" /><span id="chat-model-label">Đang tải…</span><Icon name="chevron-down" class="i-chev" />
      </button>
      <button class="send-btn" type="submit" id="chat-send" aria-label="Gửi" disabled><Icon name="send" /></button>
    </form>
    <div class="chat-status" id="chat-status" role="status"><Badge tone="warning" dot>Đang kết nối máy chủ</Badge></div>
  </div>
</div>
