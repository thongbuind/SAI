---
// Badge trên Figma: nhãn trạng thái/phiên bản, không tương tác. dot nhấp nháy cho trạng thái đang diễn ra.
interface Props {
  tone?: "accent" | "neutral" | "success" | "warning" | "danger";
  dot?: boolean;
}
const { tone = "accent", dot = false } = Astro.props;
---
<span class:list={["badge", `badge-${tone}`, { "has-dot": dot }]}><slot /></span>

<style>
  .badge { display: inline-flex; align-items: center; gap: var(--space-2); padding: var(--space-1) var(--space-3); border-radius: var(--radius-control); border: 1px solid; font: 500 12px/1 var(--font-sans); letter-spacing: 0.02em; white-space: nowrap; }
  .has-dot::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; animation: blink 2.4s ease-in-out infinite; }
  .badge-accent { background: var(--fill-accent-subtle); border-color: var(--border-strong); color: var(--text-accent); }
  .badge-neutral { background: var(--fill-highlight); border-color: var(--border-default); color: var(--text-secondary); }
  .badge-success { background: var(--fill-success-subtle); border-color: var(--border-success); color: var(--text-success); }
  .badge-warning { background: var(--fill-warning-subtle); border-color: var(--border-warning); color: var(--text-warning); }
  .badge-danger { background: var(--fill-danger-subtle); border-color: var(--border-danger); color: var(--text-danger); }
  @keyframes blink { 50% { opacity: 0.4; } }
</style>
