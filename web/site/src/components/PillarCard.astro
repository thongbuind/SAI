---
// PillarCard trên Figma: icon chip, tiêu đề, mô tả; có href thì cả thẻ là liên kết.
import IconChip from "./IconChip.astro";
import Icon from "./Icon.astro";
import type { IconName } from "../lib/icons";

interface Props {
  icon: IconName;
  title: string;
  href?: string;
  linkLabel?: string;
}
const { icon, title, href, linkLabel } = Astro.props;
const Tag = href ? "a" : "article";
---
<Tag class="pillar glass-panel" href={href}>
  <IconChip icon={icon} />
  <h3 class="t-h4">{title}</h3>
  <p class="t-small"><slot /></p>
  {href && linkLabel && <span class="link">{linkLabel} <Icon name="arrow-right" size={12} /></span>}
</Tag>

<style>
  .pillar { position: relative; display: flex; flex-direction: column; gap: var(--space-4); padding: var(--space-8) var(--space-6); overflow: hidden; border-radius: var(--radius-lg); border: 1px solid var(--border-default); background: var(--surface-base); box-shadow: var(--elevation-1); color: inherit; text-decoration: none; transition: border-color var(--duration-base), box-shadow var(--duration-base); }
  .pillar::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--gradient-accent-line); }
  .pillar h3, .pillar p { margin: 0; }
  a.pillar:hover { border-color: var(--border-strong); box-shadow: var(--elevation-2); }
  .link { display: inline-flex; align-items: center; gap: var(--space-1); margin-top: auto; font: 500 12px/1 var(--font-sans); color: var(--text-accent); }
  a.pillar:hover .link { color: var(--text-primary); }
</style>
